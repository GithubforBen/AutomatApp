# Vorlage: als .env kopieren, Werte eintragen und mit auf den ESP spielen.
# Die .env wird nicht eingecheckt.
WLAN_SSID=DEIN_WLAN
WLAN_PASSWORD=DEIN_PASSWORT
# Für Updates über WLAN - derselbe Schlüssel wie bei der Ausgabe
# (HMAC-Bildschirm des Automaten). Leer lassen = keine Updates über WLAN.
HMAC_KEY_ID=rfid
HMAC_KEY=BASE64_SCHLUESSEL_AUS_DER_APP
